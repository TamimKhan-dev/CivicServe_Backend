model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  password      String
  phone         String?
  role          Role       @default(CITIZEN)
  profileImage  String?
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  requests             Request[]          @relation("CitizenRequests")
  assignedRequests     Request[]          @relation("AssignedStaffRequests")
  staffApplications    StaffApplication[]
  reviewedApplications StaffApplication[] @relation("ApplicationReviewer")
  payments             Payment[]
  feedbacks            Feedback[]
  auditLogs            AuditLog[]

  @@index([role])
  @@index([status])
  @@map("users")
}
